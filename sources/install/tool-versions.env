#!/bin/bash
# Author: The Exegol Project
#
# Centralized version pins for all tools installed via go install, GitHub releases,
# and cargo install. Renovate reads the "# renovate:" annotations to auto-detect
# updates and open PRs.
#
# Format:
#   # renovate: datasource=<ds> depName=<name>
#   VARIABLE_NAME="version"
#
# To add a new tool:
#   1. Add a "# renovate:" comment with the correct datasource and depName
#   2. Add the VERSION variable with the current pinned version
#   3. Use ${VARIABLE_NAME} in the install script instead of @latest

# =============================================================================
# Go tools (datasource=go, uses proxy.golang.org)
# =============================================================================

# --- package_base.sh ---
# renovate: datasource=github-releases depName=asdf-vm/asdf
ASDF_VERSION="v0.18.1"

